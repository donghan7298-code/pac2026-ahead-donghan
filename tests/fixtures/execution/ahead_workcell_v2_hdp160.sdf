      <visual name="right"><pose>3.35 0 1.00 0 0 0</pose><geometry><box><size>0.05 6.20 2.00</size></box></geometry></visual>
      <visual name="left_back"><pose>-3.35 -1.50 1.00 0 0 0</pose><geometry><box><size>0.05 3.20 2.00</size></box></geometry></visual>
    </link></model>

    <model name="controller_cabinet"><static>true</static><pose>2.70 2.25 0 0 0 0</pose><link name="cabinet_link">
