    <model name="inline_scale"><static>true</static><link name="scale_link"><visual name="platform"><pose>-1.90 1.20 0.905 0 0 0</pose><geometry><box><size>0.46 0.72 0.03</size></box></geometry><material><ambient>0.10 0.25 0.45 1</ambient><diffuse>0.12 0.38 0.70 1</diffuse></material></visual></link></model>

