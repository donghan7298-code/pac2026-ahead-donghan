      <visual name="shelf_2"><pose>0 0 0.90 0 0 0</pose><geometry><box><size>1.55 0.68 0.05</size></box></geometry></visual>
      <visual name="shelf_3"><pose>0 0 1.45 0 0 0</pose><geometry><box><size>1.55 0.68 0.05</size></box></geometry></visual>
    </link></model>

    <model name="camera_mast"><static>true</static><link name="mast_link">
      <visual name="post"><pose>0.20 -2.65 2.25 0 0 0</pose><geometry><box><size>0.10 0.10 4.50</size></box></geometry></visual>
      <visual name="arm"><pose>0.20 -1.30 4.45 0 0 0</pose><geometry><box><size>0.10 2.80 0.10</size></box></geometry></visual>
    </link></model>

    <model name="camera_top_view"><static>true</static><pose>0.20 0.00 4.50 0 1.57079632679 0</pose><link name="camera_2d">
      <visual name="housing"><geometry><box><size>0.28 0.18 0.16</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <sensor name="top_view_sensor" type="camera"><always_on>true</always_on><update_rate>15</update_rate><topic>/pac/top_camera/image</topic><camera><horizontal_fov>1.40</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.10</near><far>12.0</far></clip></camera></sensor>
    </link></model>

    <model name="safety_fence"><static>true</static><link name="fence_link">
